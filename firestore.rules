rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Steak 11 - Cloud Firestore Realtime Database Rules
    // Mengizinkan sinkronisasi realtime untuk Kasir POS, Kitchen Display, Presensi Kamera Selfie, Menu, dan Admin
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

